{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'America/New_York',
  dependencyDashboard: {
    enabled: true,
    title: 'Renovate: dependency dashboard',
  },
  minimumReleaseAge: '3 days',
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  rebaseWhen: 'conflicted',
  reviewers: [
    'cjwillis48',
  ],
  prBodyNotes: [
    '---',
    '**Merging deploys this.** Argo CD auto-syncs `main` to Homie within minutes.',
    "Watch it land: `kubectl -n argocd get applications` and the touched workload's pods.",
  ],
  kubernetes: {
    managerFilePatterns: [
      '/^k8s/.+\\.ya?ml$/',
    ],
  },
  argocd: {
    managerFilePatterns: [
      '/^k8s/argocd/apps/.+\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      matchCategories: [
        'docker',
      ],
      pinDigests: false,
    },
    {
      matchManagers: [
        'kubernetes',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      ignoreTests: true,
      prConcurrentLimit: 0,
      branchConcurrentLimit: 0,
    },
    {
      matchPackageNames: [
        'cloudflare/cloudflared',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      minimumReleaseAge: '1 day',
      addLabels: [
        'public-facing',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      ignoreTests: true,
      prConcurrentLimit: 0,
      branchConcurrentLimit: 0,
    },
    {
      matchPackageNames: [
        'argoproj/argo-cd',
      ],
      labels: [
        'needs-care',
      ],
      minimumReleaseAge: '7 days',
    },
    {
      matchPackageNames: [
        'bitnami-labs/sealed-secrets',
      ],
      labels: [
        'needs-care',
      ],
      minimumReleaseAge: '7 days',
    },
    {
      matchPackageNames: [
        'longhorn',
        'k3s-io/k3s',
      ],
      labels: [
        'needs-care',
      ],
      minimumReleaseAge: '7 days',
      separateMultipleMinor: true,
      separateMinorPatch: true,
    },
    {
      matchPackageNames: [
        'k3s-io/k3s',
      ],
      prBodyNotes: [
        '---',
        '**This PR does not change the cluster.** Apply with `make upgrade-k3s` (server, then agent), then check both nodes are Ready.',
        'k3s supports upgrading one minor at a time only — never skip a minor.',
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Argo CD install manifest (remote kustomize resource)',
      managerFilePatterns: [
        '/^k8s/argocd/kustomization\\.yaml$/',
      ],
      matchStrings: [
        'argoproj/argo-cd/(?<currentValue>v[^/]+)/manifests/install\\.yaml',
      ],
      depNameTemplate: 'argoproj/argo-cd',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'Sealed Secrets controller manifest (remote kustomize resource)',
      managerFilePatterns: [
        '/^k8s/sealed-secrets/kustomization\\.yaml$/',
      ],
      matchStrings: [
        'bitnami-labs/sealed-secrets/releases/download/(?<currentValue>v[^/]+)/controller\\.yaml',
      ],
      depNameTemplate: 'bitnami-labs/sealed-secrets',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^(?<version>v.+)$',
    },
    {
      customType: 'regex',
      description: 'k3s version (role defaults + group_vars)',
      managerFilePatterns: [
        '/^ansible/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'k3s_version:\\s*["\']?(?<currentValue>v[^"\'\\s]+)["\']?',
      ],
      depNameTemplate: 'k3s-io/k3s',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$',
    },
  ],
}
